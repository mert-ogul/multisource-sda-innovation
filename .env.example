# Optional API credentials — app runs in sample mode without these.

# Live patent search via patent_client (USPTO Public Search; no key required for US)
# Requires Python 3.11 or 3.12 (patent_client does not support 3.13+ yet).
USE_PATENT_CLIENT=false
PATENT_CLIENT_MAX_RESULTS=25

# EPO Open Patent Services — also used by patent_client when set
# (maps to PATENT_CLIENT_EPO_API_KEY / PATENT_CLIENT_EPO_API_SECRET automatically)
EPO_OPS_CONSUMER_KEY=
EPO_OPS_CONSUMER_SECRET=

# Live news via newsapi.ai / Event Registry (https://newsapi.ai/documentation)
NEWS_API_KEY=
USE_LIVE_NEWS=true
NEWS_API_MAX_RESULTS=25

# User review datasets in data/raw/ (optional cap per file; 0 = unlimited)
REVIEWS_MAX_PER_SOURCE=2500

# Reddit API (https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=sda-innovation-studio/1.0
